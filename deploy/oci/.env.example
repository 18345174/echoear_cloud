# Copy to /opt/stack/echoear_cloud/.env on the server and edit.
POSTGRES_DB=echoear
POSTGRES_USER=echoear
POSTGRES_PASSWORD=change-me-postgres
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=change-me-admin
BOOTSTRAP_ADMIN_EMAIL=
PUBLIC_BASE_URL=https://echoear.example.com
CORS_ALLOWED_ORIGINS=*
HTTP_PORT=8080
GIN_MODE=release
ECHOEAR_IMAGE=ghcr.io/18345174/echoear_cloud:latest
