# Copy to /opt/stack/echoear_cloud/.env on the server and fill real values.
# Do not commit real secrets.
POSTGRES_DB=echoear
POSTGRES_USER=echoear
POSTGRES_PASSWORD=change-me-postgres
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=change-me-admin
BOOTSTRAP_ADMIN_EMAIL=
ACCESS_TICKET_SIGNING_KEY=replace-with-base64-encoded-32-byte-seed
HTTP_PORT=8080
PUBLIC_BASE_URL=https://xu-hapi.flyooo.uk
CORS_ALLOWED_ORIGINS=*
GIN_MODE=release
ECHOEAR_IMAGE=ghcr.io/18345174/echoear_cloud:latest
