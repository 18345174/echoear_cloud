# Copy to /opt/stack/echoear_cloud/.env on the server and fill real values.
# Do not commit real secrets.
POSTGRES_DB=echoear
POSTGRES_USER=echoear
POSTGRES_PASSWORD=change-me-postgres
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=change-me-admin
BOOTSTRAP_ADMIN_EMAIL=
# Optional override. When empty, one seed is generated and persisted in PostgreSQL.
ACCESS_TICKET_SIGNING_KEY=
HTTP_PORT=8080
PUBLIC_BASE_URL=https://xu-hapi.flyooo.uk
CORS_ALLOWED_ORIGINS=*
GIN_MODE=release
ECHOEAR_IMAGE=ghcr.io/18345174/echoear_cloud:latest
# Deployment manifests are synced after the one-time deploy.sh bootstrap.
ECHOEAR_SYNC_DEPLOY_FILES=true
ECHOEAR_DEPLOY_REF=main
ECHOEAR_DEPLOY_REPOSITORY=18345174/echoear_cloud

# Optional self-hosted HAPI Relay. Leave disabled until DNS and the OCI
# firewall/security-list rules described in README.md are ready.
ECHOEAR_RELAY_ENABLED=false
ECHOEAR_RELAY_IMAGE=ghcr.io/tiann/tunwg:eb51a7f
ECHOEAR_RELAY_DOMAIN=relay.xu-hapi.flyooo.uk
ECHOEAR_RELAY_PUBLIC_IP=
# Generate once with: openssl rand -hex 32
ECHOEAR_RELAY_AUTH_SECRET=
# Optional daily bytes per issued Hub key. Empty/0 means unlimited.
ECHOEAR_RELAY_QUOTA_BYTES=0
ECHOEAR_RELAY_SSL_EMAIL=
