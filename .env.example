POSTGRES_DB=echoear
POSTGRES_USER=echoear
POSTGRES_PASSWORD=change-this-database-password
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=change-this-admin-password
BOOTSTRAP_ADMIN_EMAIL=
# Optional override. When empty, one seed is generated and persisted in PostgreSQL.
ACCESS_TICKET_SIGNING_KEY=
HTTP_PORT=8080
PUBLIC_BASE_URL=https://echoear.example.com
CORS_ALLOWED_ORIGINS=*
GIN_MODE=release
